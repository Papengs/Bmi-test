<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="660.0" prefWidth="480.0" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-font-family: 'SansSerif'; -fx-font-size: 14px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BmiController">
    <padding><Insets bottom="28" left="28" right="28" top="28" /></padding>
    <children>
        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Kalkulator BMI" />
        <Label style="-fx-text-fill: #64748b;" text="Isi data, pilih standar BMI, lalu hitung." wrapText="true" />
        <Label text="Nama" />
        <TextField fx:id="namaField" promptText="Contoh: Rani" />
        <Label text="Standar BMI" />
        <ComboBox fx:id="standarBox" maxWidth="Infinity" />
        <Label text="Berat badan (kg)" />
        <TextField fx:id="beratField" promptText="Contoh: 60" />
        <Label text="Tinggi badan (cm)" />
        <TextField fx:id="tinggiField" promptText="Contoh: 160" />
        <Button defaultButton="true" maxWidth="Infinity" onAction="#hitung" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8;" text="Hitung BMI" />
        <Label fx:id="hasilLabel" minHeight="95.0" text="Hasil perhitungan akan tampil di sini." wrapText="true" />
    </children>
</VBox>
